---
import '../styles/global.css'
import iconUrl from '@resources/icon.svg?url'
import { useTranslations, locales, localeInfo, defaultLocale, localeHomeUrl, sitePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
  title?: string
  description?: string
}

const { locale = 'en', title, description } = Astro.props
const t = useTranslations(locale)
const pageTitle = title ?? t('meta.title')
const pageDescription = description ?? t('meta.description')
// Every locale page lists all of them (itself included) so the hreflang annotations are reciprocal.
const alternates = locales.map((code) => ({ hreflang: localeInfo[code].tag, href: localeHomeUrl(code, Astro.site) }))
const canonical = localeHomeUrl(locale, Astro.site)
// 1200x630, generated by `npm run og` (scripts/og-image.mjs). Absolute: crawlers do not resolve relative URLs.
const ogImage = new URL(sitePath('og.png'), Astro.site).href
const ogAlt = 'BakaSub'
---

<!doctype html>
<html lang={localeInfo[locale].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#120c18" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={localeHomeUrl(defaultLocale, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {
      locales
        .filter((code) => code !== locale)
        .map((code) => <meta property="og:locale:alternate" content={localeInfo[code].ogLocale} />)
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="BakaSub" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-background text-foreground font-sans">
    <slot />
  </body>
</html>
