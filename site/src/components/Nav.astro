---
import iconUrl from '@resources/icon.svg?url'
import GitHubIcon from './GitHubIcon.astro'
import { useTranslations, links, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}
const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<header class="sticky top-0 z-20 border-b border-border/60 bg-background/80 backdrop-blur-md">
  <nav aria-label={t('nav.primary')} class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="flex items-center gap-2.5 rounded-md font-semibold tracking-tight" aria-label={t('nav.home')}>
      <img src={iconUrl} alt="" width="28" height="28" class="size-7" />
      <span class="text-lg">Baka<span class="text-primary">Sub</span></span>
    </a>
    <div class="flex items-center gap-2">
      {/* F4: EN/PT language switcher goes here. */}
      <a
        href={links.repo}
        class="inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label={t('nav.githubLabel')}
      >
        <GitHubIcon class="size-4" />
        <span class="hidden sm:inline">{t('nav.github')}</span>
      </a>
    </div>
  </nav>
</header>
