---
import logoUrl from '@assets/logo.svg?url'
import GitHubIcon from './GitHubIcon.astro'
import { useTranslations, links, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}
const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-4xl flex-col items-center px-4 pt-14 pb-20 text-center sm:px-6 sm:pt-20 sm:pb-28">
    <div class="logo-halo relative w-full max-w-[34rem]">
      <img src={logoUrl} alt="BakaSub" width="695" height="208" class="relative h-auto w-full" fetchpriority="high" />
    </div>

    <p class="mt-8 font-mono text-xs tracking-[0.2em] text-secondary-foreground uppercase">{t('hero.kicker')}</p>
    <h1 id="hero-title" class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
      <span class="bg-brand bg-clip-text text-transparent">{t('hero.titleStrong')}</span>
      {' '}{t('hero.titleRest')}
    </h1>
    <p class="mt-5 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">{t('hero.lead')}</p>

    <div class="mt-9 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
      <a
        href={links.releases}
        class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-brand px-6 font-semibold text-primary-foreground shadow-[0_8px_30px_-8px_var(--primary)] transition hover:brightness-110"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
        </svg>
        {t('hero.download')}
      </a>
      <a
        href={links.repo}
        class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-border bg-card px-6 font-medium transition-colors hover:border-violet/60 hover:bg-muted"
      >
        <GitHubIcon class="size-4" />
        {t('hero.source')}
      </a>
    </div>
    <p class="mt-4 font-mono text-xs text-muted-foreground">{t('hero.platforms')}</p>
  </div>
</section>

<style>
  .hero-glow {
    background:
      radial-gradient(40rem 22rem at 30% 18%, color-mix(in srgb, var(--primary) 22%, transparent), transparent 70%),
      radial-gradient(36rem 22rem at 72% 30%, color-mix(in srgb, var(--violet) 20%, transparent), transparent 70%);
  }

  /* Pink/violet glow behind the logo lockup. */
  .logo-halo::before {
    content: '';
    position: absolute;
    inset: 10% 8%;
    z-index: -1;
    border-radius: 9999px;
    background: var(--brand-gradient);
    filter: blur(48px);
    opacity: 0.35;
    animation: halo 6s ease-in-out infinite alternate;
  }

  @keyframes halo {
    from {
      opacity: 0.28;
      transform: scale(0.96);
    }
    to {
      opacity: 0.42;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-halo::before {
      animation: none;
    }
  }
</style>
