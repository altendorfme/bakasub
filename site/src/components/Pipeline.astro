---
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'
import { pipelineSteps } from '../data/features'
import { useTranslations, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}
const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const last = pipelineSteps.length - 1
---

<section
  id="how-it-works"
  class="relative isolate scroll-mt-20 border-y border-border/60 bg-card/30 px-4 py-20 sm:px-6 sm:py-28"
  aria-labelledby="pipeline-title"
>
  <div class="mx-auto max-w-6xl">
    <SectionHeader id="pipeline-title" kicker={t('pipeline.kicker')} title={t('pipeline.title')} lead={t('pipeline.lead')} />

    <ol class="mt-12 grid gap-4 sm:mt-16 md:grid-cols-3 md:gap-10" role="list">
      {
        pipelineSteps.map((step, index) => (
          <li class="relative flex flex-col items-center rounded-xl border border-border bg-background p-6 text-center">
            <span class="step-badge relative inline-flex size-16 items-center justify-center rounded-2xl text-primary-foreground">
              <Icon name={step.icon} class="size-8" />
            </span>
            <p class="mt-5 font-mono text-xs tracking-[0.16em] text-secondary-foreground uppercase">
              {t('pipeline.stepLabel')} {index + 1}
            </p>
            <h3 class="mt-1 text-xl font-semibold tracking-tight">{t(step.title)}</h3>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-muted-foreground">{t(step.body)}</p>

            {index < last && (
              <svg
                class="connector absolute z-10 text-violet"
                viewBox="0 0 40 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M2 8h34" stroke-dasharray="4 4" />
                <path d="m30 3 6 5-6 5" />
              </svg>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step-badge {
    background: var(--brand-gradient);
    box-shadow: 0 10px 30px -10px var(--primary);
  }

  /* Arrow between steps: below the card when stacked, in the gap when side by side. */
  .connector {
    width: 2.5rem;
    height: 1rem;
    left: 50%;
    bottom: -0.625rem;
    transform: translate(-50%, 50%) rotate(90deg);
  }

  @media (min-width: 48rem) {
    .connector {
      left: auto;
      bottom: auto;
      top: 4rem;
      right: -2.5rem;
      transform: translate(50%, -50%);
    }
  }
</style>
