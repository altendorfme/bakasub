---
import iconUrl from '@resources/icon.svg?url'
import { useTranslations, links, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}
const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const linkClass = 'rounded-sm text-muted-foreground transition-colors hover:text-foreground'
---

<footer class="border-t border-border bg-card/40">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex items-center gap-3">
      <img src={iconUrl} alt="" width="32" height="32" class="size-8" />
      <p class="text-sm text-muted-foreground">
        {t('footer.license')}
        <a href={links.license} class="underline decoration-border underline-offset-4 hover:text-foreground">GPL-3.0</a>.
      </p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <li><a href={links.releases} class={linkClass}>{t('footer.releases')}</a></li>
      <li><a href={links.repo} class={linkClass}>{t('footer.source')}</a></li>
      <li>
        <a
          href={links.coffee}
          class="inline-flex items-center gap-2 rounded-md border border-warning/40 px-3 py-1.5 text-warning transition-colors hover:bg-warning/10"
        >
          <span aria-hidden="true">☕</span>
          {t('footer.coffee')}
        </a>
      </li>
    </ul>
  </div>
</footer>
