---
interface Props {
  /** `id` of the `<h2>`, referenced by the section's `aria-labelledby`. */
  id: string
  kicker: string
  title: string
  lead?: string
  align?: 'center' | 'start'
}
const { id, kicker, title, lead, align = 'center' } = Astro.props
const centered = align === 'center'
---

<div class:list={['max-w-2xl', centered && 'mx-auto text-center']}>
  <p class="font-mono text-xs tracking-[0.2em] text-secondary-foreground uppercase">{kicker}</p>
  <h2 id={id} class="mt-3 text-2xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-base text-pretty text-muted-foreground sm:text-lg">{lead}</p>}
</div>
