{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brand/*": ["../src/shared/brand/*"],
      "@resources/*": ["../resources/*"],
      "@assets/*": ["../src/renderer/src/assets/*"],
      "@docs/*": ["../docs/*"]
    }
  }
}
